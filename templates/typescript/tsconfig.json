{
  "$schema": "https://json.schemastore.org/tsconfig",

  "compilerOptions": {
    // --- Target and module ---
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],

    // --- Output ---
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // --- strict: true enables these 8 flags ---
    // strictNullChecks, strictFunctionTypes, strictBindCallApply,
    // strictPropertyInitialization, noImplicitAny, noImplicitThis,
    // useUnknownInCatchVariables, alwaysStrict
    "strict": true,

    // --- Additional flags NOT in strict: true ---
    // Forces handling undefined when accessing arrays/maps by index.
    // Prevents the class of bug where arr[i] silently returns undefined.
    "noUncheckedIndexedAccess": true,

    // Distinguishes absent properties from properties explicitly set to undefined.
    // Critical for auth, financial, and any domain where silent defaults are dangerous.
    "exactOptionalPropertyTypes": true,

    // Requires the override keyword when overriding class members.
    // Prevents AI-generated code from silently shadowing parent methods.
    "noImplicitOverride": true,

    // --- Additional safety flags ---
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    // --- Interop ---
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,

    // --- Skip lib check for performance ---
    "skipLibCheck": true
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "build", "**/*.test.ts", "**/*.spec.ts"]
}
