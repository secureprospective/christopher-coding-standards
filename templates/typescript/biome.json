{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",

  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,

      "suspicious": {
        "noExplicitAny": "error"
      },

      "style": {
        "noNonNullAssertion": "error",
        "noConsole": "warn"
      }
    }
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },

  "json": {
    "formatter": {
      "enabled": true
    }
  },

  "files": {
    "ignore": [
      "node_modules",
      "dist",
      "build",
      ".next",
      "coverage",
      ".stryker-tmp",
      "reports"
    ]
  }
}
