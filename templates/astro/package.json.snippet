{
  "//pnpm-guardrail": "Fleet standard: this project is pinned to pnpm via corepack + only-allow. See the base TypeScript overlay README for the enforced rules (packageManager pin, only-allow pnpm, --frozen-lockfile). Do not remove these lines.",
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format:astro": "prettier --write \"**/*.astro\"",
    "lint:astro": "prettier --check \"**/*.astro\"",
    "typecheck:astro": "astro check"
  },

  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.1"
  }
}
