# Merge into the existing repos list; use the project's locked installation.
# Read-only: formatting is a separate deliberate command, not a commit side effect.
  - repo: local
    hooks:
      - id: prettier-astro
        name: prettier (astro)
        entry: pnpm exec prettier --check --
        language: system
        files: \.astro$
        pass_filenames: true
