{
  "type": "module",

  "scripts": {
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:deps": "depcruise --config .dependency-cruiser.cjs --output-type err server/src",
    "check:file-length": "bun scripts/check-file-length.ts",
    "check:components": "bun scripts/check-component-purity.ts",
    "check:all": "bun run typecheck && bun run lint && bun run check:deps && bun run check:file-length && bun run check:components && bun run test"
  },

  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "^1.3.14",
    "dependency-cruiser": "17.4.3",
    "typescript": "^5.8.0",
    "zod": "^4.0.0"
  }
}
