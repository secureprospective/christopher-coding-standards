# Makefile snippet — Go overlay. Mirrors the TypeScript overlay's target names
# (lint / fmt / test / test-coverage / mutation-test / build) so muscle memory
# transfers across languages. Merge these targets into the project Makefile.

.PHONY: lint fmt vet test test-coverage build mutation-test ifaceguard

# ifaceguard — the custom go/analysis vettool that flags empty-interface
# (interface{}/any) escapes in EXPORTED signatures. This is the ONE gap no
# enabled golangci-lint linter covers (Fable Friction #10, 2026-06-13):
# interfacebloat only checks interface *declarations*, not bare any in a
# signature. Built from its own pinned module under tools/ifaceguard.
IFACEGUARD_BIN := tools/ifaceguard/bin/ifaceguard

$(IFACEGUARD_BIN): tools/ifaceguard/ifaceguard.go tools/ifaceguard/cmd/ifaceguard/main.go tools/ifaceguard/go.mod
	cd tools/ifaceguard && go build -o bin/ifaceguard ./cmd/ifaceguard

ifaceguard: $(IFACEGUARD_BIN)
	go vet -vettool=$(abspath $(IFACEGUARD_BIN)) ./...

# filelen — enforces the 400-line file cap (companion plan: "a design
# constraint, not a cleanup step"; AD-14/AD-17 pre-splits). golangci-lint's
# funlen caps FUNCTION size, NOT file size, and no enabled linter measures file
# length — so the cap had no automated gate (Confidence-80 plan-fidelity sweep,
# 2026-06-13). This is that gate: a pure-shell backstop to the design-time
# pre-split, no new dependency. Test files are exempt (table-driven tests run
# long, mirroring the funlen test-relief).
FILE_CAP := 400
.PHONY: filelen
filelen:
	@offenders=$$(find . -name '*.go' -not -name '*_test.go' -not -path './vendor/*' -not -path './tools/*' \
	  -exec awk 'END { if (NR > $(FILE_CAP)) printf "  %s (%d lines)\n", FILENAME, NR }' {} \;); \
	if [ -n "$$offenders" ]; then \
	  echo "FILE CAP ($(FILE_CAP) lines) exceeded — pre-split per the wireframe (AD-14/AD-17) BEFORE commit:"; \
	  echo "$$offenders"; exit 1; \
	else echo "filelen: all source files within the $(FILE_CAP)-line cap"; fi

# lint runs golangci-lint, ifaceguard, AND filelen — all must pass to clear.
lint: ifaceguard filelen
	golangci-lint run ./...

fmt:
	gofmt -w .
	goimports -w .

vet:
	go vet ./...

# -race is non-negotiable (companion plan Section 1 / failure mode #2:
# concurrent map access from Wails IPC goroutines). Never make this optional.
test:
	go test -race ./...

# Threshold mirrors the TS overlay's intent: "80% line coverage with a 40%
# mutation score means tests observe but don't assert." Line coverage alone
# is the floor, not the goal — mutation-test below is where correctness lives.
COVERAGE_THRESHOLD := 80

test-coverage:
	go test -race -coverprofile=coverage.out ./...
	go tool cover -func=coverage.out
	@total=$$(go tool cover -func=coverage.out | grep '^total:' | grep -oE '[0-9]+\.[0-9]+'); \
	awk -v t="$$total" -v min="$(COVERAGE_THRESHOLD)" 'BEGIN { if (t+0 < min+0) { printf "coverage %.1f%% < threshold %d%%\n", t, min; exit 1 } else { printf "coverage %.1f%% >= threshold %d%%\n", t, min } }'

# wails build for the desktop shell. Before Wails is wired (G0/B0-early),
# substitute: go build ./...
build:
	wails build

# gremlins v0.6.0, pinned (G0 viability check, 2026-06-13: repo active,
# pushed 2026-06-12, not archived — see templates/go/README.md). Scoped to
# internal/engine/... per the agy Go-architect recommendation (companion plan
# Section 8B) — pure-logic packages are where mutation score has signal.
mutation-test:
	go run github.com/go-gremlins/gremlins/cmd/gremlins@v0.6.0 unleash ./internal/engine/...
