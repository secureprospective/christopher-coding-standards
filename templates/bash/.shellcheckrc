# Bash/source resolution plus explicit optional checks. Base checks stay on;
# this selected set is not complete security/correctness coverage.
shell=bash
external-sources=true
source-path=SCRIPTDIR

# Keep expansions quoted/braced, conditions explicit and command lookup portable.
enable=quote-safe-variables
enable=require-variable-braces
enable=avoid-nullary-conditions
enable=check-unassigned-uppercase
enable=deprecate-which
