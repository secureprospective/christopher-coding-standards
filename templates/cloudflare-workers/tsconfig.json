{
  "$schema": "https://json.schemastore.org/tsconfig",

  // Cloudflare Workers tsconfig. For a Workers project, use THIS file INSTEAD of
  // the base TypeScript overlay's tsconfig.json (same relationship the Astro overlay
  // has). It carries every strict flag from the base overlay, plus Workers specifics.
  "compilerOptions": {
    // --- Target and module ---
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],

    // --- Workers-specific ---
    // wrangler bundles the Worker (esbuild under the hood), so tsc never emits.
    // Type-check only; let wrangler build.
    "noEmit": true,
    // Generated by `wrangler types` (npm run cf-typegen). Provides the typed Env
    // (your bindings) AND the workerd runtime types keyed to compatibility_date.
    // Prefer this over manually depending on @cloudflare/workers-types — it cannot
    // drift from wrangler.jsonc the way a hand-pinned types package can.
    "types": ["./worker-configuration.d.ts"],

    // --- strict: true enables strictNullChecks, strictFunctionTypes,
    // strictBindCallApply, strictPropertyInitialization, noImplicitAny,
    // noImplicitThis, useUnknownInCatchVariables, alwaysStrict ---
    "strict": true,

    // --- Additional flags NOT in strict: true (carried from the base overlay) ---
    // arr[i] is T | undefined — forces handling the miss. Critical at trust boundaries.
    "noUncheckedIndexedAccess": true,
    // Absent property != property set to undefined. Kills silent auth/financial defaults.
    "exactOptionalPropertyTypes": true,
    // override keyword required — stops AI-generated code silently shadowing methods.
    "noImplicitOverride": true,

    // --- Additional safety flags ---
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    // --- Interop ---
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,

    "skipLibCheck": true
  },

  "include": ["src/**/*", "worker-configuration.d.ts"],
  "exclude": ["node_modules", "dist", "build", "**/*.test.ts", "**/*.spec.ts"]
}
