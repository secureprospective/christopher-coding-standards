{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment_known_limitations": "permissions.deny rules in Claude Code have documented enforcement bugs (GitHub issues #6631, #18160, #27040, #31925, ongoing). Treat this file as belt-and-suspenders, NOT as the sole boundary for sensitive files. OS-level containment (container scope, filesystem permissions, LXC/microVM isolation) is required.",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets/**)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/secrets/**)",
      "Bash(sudo *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf .)",
      "Bash(docker run --privileged*)",
      "Bash(chmod 777 *)",
      "Bash(chown -R *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(rm -rf *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(docker push*)",
      "Bash(make deploy*)",
      "Bash(terraform apply*)",
      "Bash(kubectl apply*)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git stash*)",
      "Bash(git pull)",
      "Bash(git fetch*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(pwd)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(tree *)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
