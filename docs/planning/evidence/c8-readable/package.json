{
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check:deps": "depcruise --config .dependency-cruiser.cjs --output-type err server/src",
    "check:file-length": "bun scripts/check-file-length.ts",
    "check:components": "bun scripts/check-component-purity.ts",
    "check:all": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "@types/bun": "1.4.2",
    "dependency-cruiser": "17.4.3"
  },
  "name": "bee-c8-fixture",
  "version": "0.0.0",
  "private": true
}
